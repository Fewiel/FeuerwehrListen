@using FeuerwehrListen.Client.Models
@using FeuerwehrListen.Client.Services
@inject AppContextService AppCtx
@inject NavigationManager Nav
@implements IDisposable

@* Rahmen des Mitgliederbereichs (Design A): rote Kopfzeile, unten eine Tab-Leiste. Wird vom
   MemberLayout UND vom MainLayout (fuer angemeldete Mitglieder) benutzt, damit Wachen, Kalender
   und Fuehrungskreis dieselbe Navigation haben wie "Mein Bereich". Tabs nur fuer freigegebene
   Bereiche - der Server sperrt den Rest zusaetzlich. *@

<div class="fwm-shell">
    <header class="fwm-head">
        <a href="/mein" class="fwm-brand">
            @if (!string.IsNullOrWhiteSpace(_ctx?.LogoUrl)) { <img src="@_ctx!.LogoUrl" alt="" /> }
            <span>@(_ctx?.AppName ?? "Feuerwehr")</span>
        </a>
        <div class="fwm-head-right">
            <a href="/mein" class="fwm-iconbtn" aria-label="Start"><i class="bi bi-house"></i></a>
            <a href="/mein/profil" class="fwm-iconbtn" aria-label="Profil"><i class="bi bi-person-circle"></i></a>
        </div>
    </header>

    <div class="fwm-scroll">
        <main class="fwm-main @(Wide ? "fwm-main-wide" : "")">
            @ChildContent
        </main>
    </div>

    <nav class="fwm-tabs" aria-label="Mitgliederbereich">
        <a href="/mein" class="@Tab("mein", true)"><i class="bi bi-house"></i><span>Start</span></a>
        @if (TabCount <= 5) { <a href="/mein/ausweis" class="@Tab("mein/ausweis")"><i class="bi bi-person-vcard"></i><span>Ausweis</span></a> }
        @if (HasLists) { <a href="/mein/listen" class="@ListTab()"><i class="bi bi-clipboard-check"></i><span>Listen</span></a> }
        @if (M.FireSafety) { <a href="/firesafetywatches" class="@Tab("firesafetywatches")"><i class="bi bi-shield-check"></i><span>Wachen</span></a> }
        @if (M.Defects) { <a href="/defects" class="@Tab("defects")"><i class="bi bi-tools"></i><span>Mängel</span></a> }
        @if (M.Calendar) { <a href="/kalender" class="@Tab("kalender")"><i class="bi bi-calendar3"></i><span>Kalender</span></a> }
        @if (M.Leadership) { <a href="/fuehrungskreis" class="@Tab("fuehrungskreis")"><i class="bi bi-people"></i><span>Führung</span></a> }
    </nav>
</div>

<style>
    /* Feste App-Huelle: genau so hoch wie der sichtbare Bereich (dvh beruecksichtigt Browser- und
       Android-Leisten). Nur der Inhalt scrollt, Kopf und Tab-Leiste bleiben stehen - die Leiste
       ist kein position:fixed mehr und rutscht so nicht hinter die Android-Navigation. */
    .fwm-shell { height: 100vh; height: 100dvh; background: #F4F2EF; color: #1A1A1A; display: flex; flex-direction: column; overflow: hidden; }
    .fwm-head { background: #C8102E; color: #fff; height: 56px; flex-shrink: 0; display: flex; align-items: center; padding-left: 16px; padding-right: 8px; z-index: 20; }
    .fwm-brand { color: #fff; text-decoration: none; display: flex; align-items: center; font-weight: 700; font-size: 1.05rem; flex: 1; min-width: 0; }
    .fwm-brand img { height: 30px; width: auto; margin-right: 8px; }
    .fwm-brand span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fwm-head-right { display: flex; }
    .fwm-iconbtn { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.35rem; text-decoration: none; }
    .fwm-iconbtn:hover { color: #fff; opacity: .85; }
    /* Nur senkrecht scrollen; nichts darf seitlich ueberstehen (Bootstrap-Raster mit negativen Raendern). */
    .fwm-scroll { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; background: #F4F2EF; }
    /* "main" erbt aus app.css flex:1 + einen kuehleren Grauton -> sichtbare graue Flaeche unter dem Inhalt. */
    .fwm-main { flex: none; background: transparent; width: 100%; max-width: 640px; margin-left: auto; margin-right: auto; padding: 16px; box-sizing: border-box; }
    .fwm-main > :last-child { margin-bottom: 0; }
    /* Listen-Seiten (Wachen, Kalender, Fuehrungskreis) brauchen die volle Breite. */
    .fwm-main-wide { max-width: 1280px; padding-left: 0; padding-right: 0; }
    /* Standard-Seiten im Mitgliedsrahmen: kein Extra-Leerraum unten (sonst Scrollen ohne Inhalt). */
    .fwm-main-wide .content { padding-top: 0; padding-bottom: 0; }
    .fwm-main-wide .container, .fwm-main-wide .container-fluid { max-width: 100%; padding-left: 0; padding-right: 0; }
    .fwm-main-wide .container.mt-4, .fwm-main-wide .container-fluid.mt-4, .fwm-main-wide .container.mt-3, .fwm-main-wide .container-fluid.mt-3 { margin-top: 0 !important; }
    .fwm-main-wide img, .fwm-main-wide table { max-width: 100%; }
    .fwm-tabs { flex-shrink: 0; height: 64px; background: #fff; border-top: 1px solid #E5E1DB; display: flex; z-index: 20; padding-bottom: env(safe-area-inset-bottom, 0px); box-sizing: content-box; }
    .fwm-tabs a { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #5C5853; text-decoration: none; font-size: .75rem; }
    .fwm-tabs a i { font-size: 1.3rem; margin-bottom: 2px; }
    .fwm-tabs a.active { color: #C8102E; font-weight: 600; }
    .fwm-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,.07); padding: 16px; margin-bottom: 14px; }
    .fwm-label { font-size: .7rem; color: #5C5853; text-transform: uppercase; letter-spacing: .06em; }
    .fwm-btn { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 50px; border-radius: 12px; border: 0; background: #C8102E; color: #fff; font-weight: 600; font-size: 1rem; text-decoration: none; }
    .fwm-btn:hover { color: #fff; background: #A50D26; }
    .fwm-btn i { margin-right: 8px; }
    .fwm-btn-outline { background: #fff; color: #1A1A1A; border: 1.5px solid #CFCAC3; }
    .fwm-btn-outline:hover { background: #F8F7F5; color: #1A1A1A; }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Volle Breite fuer Listen-/Kalenderseiten statt der schmalen Karten-Spalte.</summary>
    [Parameter] public bool Wide { get; set; }

    private AppContextDto? _ctx;
    private ModuleFlags M => _ctx?.Modules ?? new ModuleFlags(false, false, false, false, false, false, false, false);
    private bool HasLists => M.Attendance || M.Operations;
    private int TabCount => 2 + (HasLists ? 1 : 0) + (M.FireSafety ? 1 : 0) + (M.Defects ? 1 : 0) + (M.Calendar ? 1 : 0) + (M.Leadership ? 1 : 0);
    // "Listen" auch auf den Listen-Detailseiten markieren.
    private string ListTab()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        return rel == "mein/listen" || rel.StartsWith("attendance/") || rel.StartsWith("operation/") || rel is "create-attendance" or "create-operation" ? "active" : "";
    }

    protected override async Task OnInitializedAsync()
    {
        _ctx = await AppCtx.GetAsync();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => StateHasChanged();

    private string Tab(string path, bool exact = false)
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        var hit = exact ? rel == path : rel == path || rel.StartsWith(path + "/");
        return hit ? "active" : "";
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
