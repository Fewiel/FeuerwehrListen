@page "/admin/passwort-vergabe"
@layout MainLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Passwort-Vergabe - Admin</PageTitle>

<AuthGuard RequireAdmin="true">
    <div class="container mt-4" style="max-width:720px;">
        <h1>Passwort-Vergabe</h1>
        <p class="text-muted">
            Mitglieder legen ihr Passwort für den Mitgliederbereich selbst fest – am Tablet im Gerätehaus und im
            Beisein eines Admins. Du startest den Vergabe-Modus, bleibst daneben und prüfst anhand von Name und
            Lichtbild, dass die richtige Person das Passwort setzt. Auch „Passwort vergessen“ läuft über diesen Weg.
        </p>

        @if (_status is null) { <p><em>Lade…</em></p> }
        else
        {
            <div class="card mb-3"><div class="card-body">
                <div class="mb-2">
                    @if (_status.AllowedDevice) { <span class="badge bg-success"><i class="bi bi-check-lg"></i> Gerät steht auf der IP-Whitelist</span> }
                    else
                    {
                        <span class="badge bg-danger">Dieses Gerät steht nicht auf der IP-Whitelist</span>
                        <div class="small text-muted mt-1">Gesehene Adresse: <code>@_status.ClientIp</code> – Whitelist unter Einstellungen › Zugriffsschutz.</div>
                    }
                </div>
                @if (_status.Active)
                {
                    <p class="mb-2">Vergabe-Modus läuft seit @_status.StartedAt?.ToString("HH:mm") Uhr. Er endet nach 30 Minuten ohne Eingabe.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/passwort-vergabe" class="btn btn-primary btn-lg"><i class="bi bi-tablet me-1"></i> Vergabe-Bildschirm öffnen</a>
                        <button class="btn btn-outline-danger btn-lg" @onclick="Stop">Modus beenden</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-primary btn-lg" @onclick="Start" disabled="@(!_status.AllowedDevice || _busy)">Vergabe-Modus starten</button>
                }
                @if (_error is not null) { <div class="alert alert-danger py-2 mt-2 mb-0">@_error</div> }
            </div></div>

            <div class="card"><div class="card-body">
                <h5 class="card-title">Heute vergeben</h5>
                @if (_status.Today.Count == 0) { <p class="text-muted mb-0">Noch keine.</p> }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var t in _status.Today)
                        {
                            <li class="list-group-item d-flex justify-content-between"><span>@t.Name · @t.Number</span><span class="text-muted">@t.At?.ToString("HH:mm")</span></li>
                        }
                    </ul>
                }
            </div></div>
        }
    </div>
</AuthGuard>

@code {
    private StatusDto? _status;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { _status = await Http.GetFromJsonAsync<StatusDto>("client-api/admin/enrollment"); }
        catch { _error = "Status konnte nicht geladen werden."; }
    }

    private async Task Start()
    {
        _busy = true; _error = null;
        try
        {
            var resp = await Http.PostAsync("client-api/admin/enrollment/start", null);
            var r = await resp.Content.ReadFromJsonAsync<OkDto>();
            if (r?.Ok == true) { Nav.NavigateTo("/passwort-vergabe"); return; }
            _error = r?.Error == "device" ? "Nur an Geräten der IP-Whitelist möglich." : "Start fehlgeschlagen.";
        }
        catch { _error = "Start fehlgeschlagen."; }
        finally { _busy = false; }
    }

    private async Task Stop()
    {
        try { await Http.PostAsync("client-api/admin/enrollment/stop", null); } catch { }
        await Load();
    }

    private record TodayDto(string Name, string Number, DateTime? At);
    private record StatusDto(bool Active, DateTime? StartedAt, bool AllowedDevice, string ClientIp, List<TodayDto> Today);
    private record OkDto(bool Ok, string? Error = null);
}
