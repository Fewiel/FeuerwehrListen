@page "/admin/vehicles"
@layout MainLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Fahrzeuge - Admin</PageTitle>

<AuthGuard RequireAdmin="true">
    <div class="container mt-4">
        <div class="row mb-4">
            <div class="col"><h1>Fahrzeuge</h1></div>
            <div class="col-auto"><button class="btn btn-primary" @onclick="ShowAdd"><i class="bi bi-plus-circle"></i> Neues Fahrzeug</button></div>
        </div>

        @if (_showForm)
        {
            <div class="row mb-4"><div class="col-md-8 offset-md-2"><div class="card"><div class="card-body">
                <h5 class="card-title">@(_editId is null ? "Neues Fahrzeug" : "Fahrzeug bearbeiten")</h5>
                <div class="mb-3"><label class="form-label">Name</label><input class="form-control" @bind="_name" placeholder="z.B. Löschfahrzeug 10" /></div>
                <div class="mb-3"><label class="form-label">Funkrufname</label><input class="form-control" @bind="_callSign" placeholder="z.B. Florian Musterstadt 10/1" /></div>
                <div class="mb-3"><label class="form-label">Typ</label>
                    <select class="form-select" @bind="_type">
                        <option value="LF">LF - Löschfahrzeug</option><option value="TLF">TLF - Tanklöschfahrzeug</option>
                        <option value="DLK">DLK - Drehleiter</option><option value="RW">RW - Rüstwagen</option>
                        <option value="MTW">MTW - Mannschaftstransportwagen</option><option value="KdoW">KdoW - Kommandowagen</option>
                        <option value="Sonstige">Sonstige</option>
                    </select>
                </div>
                @* Reihenfolge beachten: die E2E-Tests adressieren Name/Funkrufname per Position
                   (input nth=0/nth=1) und den Typ als erstes select. Neue Felder daher nur HIER unten. *@
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="act" @bind="_isActive" /><label class="form-check-label" for="act">Aktiv</label></div></div>
                <hr />
                <div class="mb-3"><div class="form-check">
                    <input class="form-check-input" type="checkbox" id="showops" @bind="_showInOperations" />
                    <label class="form-check-label" for="showops">Bei Einsatzlisten zur Auswahl anbieten</label>
                    <div class="form-text">Ausschalten für Fahrzeuge, die nur im Kalender gebucht werden.</div>
                </div></div>
                <div class="mb-3"><div class="form-check">
                    <input class="form-check-input" type="checkbox" id="bookable" @bind="_isBookable" />
                    <label class="form-check-label" for="bookable">Im Kalender buchbar</label>
                </div></div>
                <div class="mb-3"><div class="form-check">
                    <input class="form-check-input" type="checkbox" id="needappr" @bind="_requiresApproval" />
                    <label class="form-check-label" for="needappr">Buchung braucht Freigabe</label>
                </div></div>
                @if (_requiresApproval)
                {
                    <div class="mb-3">
                        <label class="form-label">Zuständige für die Freigabe</label>
                        <input class="form-control" @bind="_approverEmails" placeholder="max@wehr.de, chef@wehr.de" />
                        <div class="form-text">Mehrere Adressen mit Komma trennen. Alle erhalten den Freigabe-Link; die erste Entscheidung zählt.</div>
                    </div>
                }
                @if (_error is not null) { <div class="alert alert-danger py-2">@_error</div> }
                <button class="btn btn-primary me-2" @onclick="Save" disabled="@_saving">Speichern</button>
                <button class="btn btn-secondary" @onclick="() => _showForm = false">Abbrechen</button>
            </div></div></div></div>
        }

        @if (!_showForm && _error is not null) { <div class="alert alert-danger">@_error</div> }

        <div class="card"><div class="card-body">
            @if (_items is null) { <p><em>Lade…</em></p> }
            else if (_items.Count == 0) { <p class="text-muted">Keine Fahrzeuge vorhanden</p> }
            else
            {
                <div class="table-responsive"><table class="table table-hover">
                    <thead><tr><th>Name</th><th>Funkrufname</th><th>Typ</th><th>Status</th><th>Erstellt am</th><th>Aktionen</th></tr></thead>
                    <tbody>
                        @foreach (var v in _items)
                        {
                            <tr>
                                <td><strong>@v.Name</strong></td><td>@v.CallSign</td><td>@GetVehicleTypeName(v.Type)</td>
                                <td>
                                    @if (v.IsActive) { <span class="badge bg-success">Aktiv</span> } else { <span class="badge bg-secondary">Inaktiv</span> }
                                    @if (!v.ShowInOperations) { <span class="badge bg-info ms-1">nur Kalender</span> }
                                    @if (v.RequiresApproval) { <span class="badge bg-warning text-dark ms-1">Freigabe</span> }
                                </td>
                                <td>@v.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary me-2" @onclick="() => Edit(v)">Bearbeiten</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => Delete(v.Id)">Löschen</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    </div>
</AuthGuard>

@code {
    private List<VehicleDto>? _items;
    private bool _showForm, _saving;
    private int? _editId;
    private string _name = "", _callSign = "", _type = "LF";
    private bool _isActive = true;
    private bool _showInOperations = true, _isBookable = true, _requiresApproval;
    private string _approverEmails = "";
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { try { _items = await Http.GetFromJsonAsync<List<VehicleDto>>("client-api/admin/vehicles"); } catch { _items = new(); } }

    private void ShowAdd()
    {
        _editId = null; _name = ""; _callSign = ""; _type = "LF"; _isActive = true;
        _showInOperations = true; _isBookable = true; _requiresApproval = false; _approverEmails = "";
        _error = null; _showForm = true;
    }

    private void Edit(VehicleDto v)
    {
        _editId = v.Id; _name = v.Name; _callSign = v.CallSign; _type = v.Type; _isActive = v.IsActive;
        _showInOperations = v.ShowInOperations; _isBookable = v.IsBookable;
        _requiresApproval = v.RequiresApproval; _approverEmails = v.ApproverEmails ?? "";
        _error = null; _showForm = true;
    }

    private async Task Save()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_callSign)) { _error = "Bitte Name und Funkrufname ausfüllen."; return; }
        _saving = true;
        try
        {
            // Alle Felder mitsenden: fehlt eins im Body, deserialisiert .NET es still als false
            // und das Fahrzeug waere ungewollt aus den Einsatzlisten ausgeblendet.
            var body = new
            {
                Name = _name,
                CallSign = _callSign,
                Type = _type,
                IsActive = _isActive,
                ShowInOperations = _showInOperations,
                IsBookable = _isBookable,
                RequiresApproval = _requiresApproval,
                ApproverEmails = _approverEmails
            };
            var resp = _editId is int id
                ? await Http.PutAsJsonAsync($"client-api/admin/vehicles/{id}", body)
                : await Http.PostAsJsonAsync("client-api/admin/vehicles", body);
            if (!resp.IsSuccessStatusCode) { _error = "Speichern fehlgeschlagen."; return; }
            _showForm = false;
            await Load();
        }
        catch { _error = "Speichern fehlgeschlagen."; }
        finally { _saving = false; }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Dieses Fahrzeug wirklich löschen?")) return;
        _error = null;
        try { await Http.DeleteAsync($"client-api/admin/vehicles/{id}"); await Load(); }
        catch { _error = "Löschen fehlgeschlagen."; }
    }

    private static string GetVehicleTypeName(string type) => type switch
    {
        "LF" => "LF - Löschfahrzeug",
        "TLF" => "TLF - Tanklöschfahrzeug",
        "DLK" => "DLK - Drehleiter",
        "RW" => "RW - Rüstwagen",
        "MTW" => "MTW - Mannschaftstransportwagen",
        "KdoW" => "KdoW - Kommandowagen",
        "Sonstige" => "Sonstige",
        _ => type
    };

    private record VehicleDto(int Id, string Name, string CallSign, string Type, bool IsActive,
        bool ShowInOperations, bool IsBookable, bool RequiresApproval, string? ApproverEmails, DateTime CreatedAt);
}
