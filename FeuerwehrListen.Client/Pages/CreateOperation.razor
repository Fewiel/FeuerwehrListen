@page "/create-operation"
@layout MainLayout
@using FeuerwehrListen.Client.Models
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Neue Einsatzliste</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header"><h3>Neue Einsatzliste erstellen</h3></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Einsatznummer</label>
                        <input type="text" class="form-control" @bind="_operationNumber" />
                    </div>
                    <div class="mb-3 position-relative">
                        <label class="form-label">Stichwort</label>
                        <input type="text" class="form-control" value="@_keywordInput" @oninput="OnKeywordInput" placeholder="Stichwort eingeben oder auswählen" autocomplete="off" />
                        @if (_showKeywords)
                        {
                            var kws = FilteredKeywords();
                            @if (kws.Count > 0)
                            {
                                <div class="list-group position-absolute w-100 shadow" style="z-index:1050; max-height:240px; overflow-y:auto;">
                                    @foreach (var k in kws)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action py-1 px-2" @onclick="() => PickKeyword(k)">
                                            <strong>@k.Name</strong>@if (!string.IsNullOrWhiteSpace(k.Description)) { <span class="text-muted small ms-1">– @k.Description</span> }
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Alarmierungszeit</label>
                        <input type="datetime-local" class="form-control" @bind="_alertTime" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adresse (optional)</label>
                        <input type="text" class="form-control" @bind="_address" placeholder="Straße Hausnummer, PLZ Ort" />
                    </div>
                    @if (_error is not null)
                    {
                        <div class="alert alert-danger py-2">@_error</div>
                    }
                    @if (_dup is not null)
                    {
                        <div class="alert alert-warning">
                            <strong><i class="bi bi-exclamation-triangle me-1"></i>Zu dieser Einsatznummer gibt es schon eine offene Liste</strong><br />
                            @_dup.Keyword · @_dup.AlertTime.ToString("dd.MM.yyyy HH:mm")@(string.IsNullOrWhiteSpace(_dup.Address) ? "" : " · " + _dup.Address)
                            <div class="small text-muted mt-1">Doppelalarmierung der Leitstelle? Dann einfach die vorhandene Liste weiterverwenden.</div>
                            <div class="d-grid gap-2 mt-2">
                                <a class="btn btn-warning" href="@($"/operation/{_dup.Id}")"><i class="bi bi-box-arrow-in-right me-1"></i>Vorhandene Liste öffnen</a>
                                <button class="btn btn-outline-secondary" @onclick="() => CreateList(force: true)" disabled="@_saving">Trotzdem neue Liste anlegen</button>
                            </div>
                        </div>
                    }
                    <div class="d-grid gap-2">
                        <button class="btn btn-danger btn-lg" @onclick="CreateList" disabled="@_saving">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Liste erstellen
                        </button>
                        <a class="btn btn-secondary" href="/">Abbrechen</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _operationNumber = string.Empty;
    private string _keywordInput = string.Empty;
    private DateTime _alertTime = DateTime.Now;
    private string _address = string.Empty;
    private List<KeywordDto> _keywords = new();
    private bool _showKeywords;
    private bool _saving;
    private string? _error;

    // Stichwort-Vorschlaege clientseitig filtern (kein <datalist> -> funktioniert auch auf iOS 12).
    private List<KeywordDto> FilteredKeywords()
    {
        var q = _keywordInput.Trim();
        IEnumerable<KeywordDto> src = _keywords;
        if (q.Length > 0)
            src = _keywords.Where(k => (k.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                    || (k.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        return src.Take(8).ToList();
    }

    private void OnKeywordInput(ChangeEventArgs e)
    {
        _keywordInput = e.Value?.ToString() ?? string.Empty;
        _showKeywords = true;
    }

    private void PickKeyword(KeywordDto k)
    {
        _keywordInput = k.Name;
        _showKeywords = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try { _keywords = await Http.GetFromJsonAsync<List<KeywordDto>>("client-api/keywords") ?? new(); }
        catch { }
    }

    private DupDto? _dup;

    private async Task CreateList() => await CreateList(false);

    private async Task CreateList(bool force)
    {
        _error = null; _dup = null;
        if (string.IsNullOrWhiteSpace(_operationNumber) || string.IsNullOrWhiteSpace(_keywordInput))
        {
            _error = "Bitte Einsatznummer und Stichwort ausfüllen.";
            return;
        }
        _saving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("client-api/operation/create",
                new { OperationNumber = _operationNumber, Keyword = _keywordInput, AlertTime = _alertTime, Address = _address, Force = force });
            if (!resp.IsSuccessStatusCode) { _error = "Erstellen fehlgeschlagen."; return; }
            var res = await resp.Content.ReadFromJsonAsync<CreatedDto>();
            if (res?.Status == "duplicate") { _dup = new DupDto(res.Id, res.Keyword ?? "", res.AlertTime ?? DateTime.Now, res.Address); return; }
            Nav.NavigateTo($"/operation/{res!.Id}", forceLoad: true);
        }
        catch { _error = "Erstellen fehlgeschlagen. Bitte erneut versuchen."; }
        finally { _saving = false; }
    }

    private record CreatedDto(int Id, string? Status = null, string? Keyword = null, DateTime? AlertTime = null, string? Address = null);
    private record DupDto(int Id, string Keyword, DateTime AlertTime, string? Address);
}
