@page "/defects"
@layout MainLayout
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Mängelliste</PageTitle>

<div class="container mt-4">
    <div class="d-flex align-items-center mb-3" style="gap:10px;">
        <h1 class="mb-0 flex-grow-1">Mängelliste</h1>
        <button class="btn btn-primary" @onclick="ShowReport"><i class="bi bi-plus-circle"></i><span class="d-none d-sm-inline ms-1">Neuer Mangel</span></button>
    </div>
    @* Filter als gleich breite Leiste - passt auch auf schmale Handys ohne Umbruch. *@
    <div class="d-flex mb-3" style="gap:6px;">
        <button class="btn btn-sm flex-fill @(_filter is null ? "btn-dark" : "btn-outline-secondary")" style="min-height:40px;" @onclick="() => _filter = null">Alle</button>
        <button class="btn btn-sm flex-fill @(_filter == "Open" ? "btn-danger" : "btn-outline-danger")" style="min-height:40px;" @onclick="@(() => _filter = "Open")">Offen</button>
        <button class="btn btn-sm flex-fill @(_filter == "InProgress" ? "btn-warning" : "btn-outline-warning")" style="min-height:40px;" @onclick="@(() => _filter = "InProgress")">In Arbeit</button>
        <button class="btn btn-sm flex-fill @(_filter == "Done" ? "btn-success" : "btn-outline-success")" style="min-height:40px;@(_filter == "Done" ? "" : "border-color:#198754;color:#198754;")" @onclick="@(() => _filter = "Done")">Erledigt</button>
    </div>

    <div class="card"><div class="card-body p-0 p-sm-3">
        @if (_loadError is not null)
        {
            <div class="alert alert-danger">@_loadError</div>
            <button class="btn btn-secondary" @onclick="Load"><i class="bi bi-arrow-clockwise me-1"></i>Erneut versuchen</button>
        }
        else if (_items is null) { <p><em>Lade…</em></p> }
        else
        {
            var list = _filter is null ? _items : _items.Where(d => d.Status == _filter).ToList();
            @if (list.Count == 0) { <p class="text-muted">Keine Mängel.</p> }
            else
            {
                @* Karten-Liste statt Tabelle: auf dem Handy kein Quer-Scrollen, Beschreibung bricht um. *@
                <div class="list-group list-group-flush">
                    @foreach (var d in list)
                    {
                        <button type="button" class="list-group-item list-group-item-action py-3" @onclick="() => OpenDetail(d)">
                            <div class="d-flex align-items-center mb-1" style="gap:8px;">
                                <strong class="flex-grow-1 text-truncate">@d.Vehicle</strong>
                                @Badge(d.Status)
                            </div>
                            <div style="white-space:pre-line;overflow-wrap:anywhere;">@d.Description</div>
                            <div class="small text-muted mt-1">@d.ReportedAt.ToString("dd.MM.yyyy HH:mm") · @d.ReportedByName</div>
                        </button>
                    }
                </div>
            }
        }
    </div></div>
</div>

@if (_showReport)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)"><div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Neuer Mangel</h5><button class="btn-close" @onclick="() => _showReport = false"></button></div>
        <div class="modal-body">
            <div class="mb-3"><label class="form-label">Beschreibung</label><textarea class="form-control" rows="3" @bind="_rDesc"></textarea></div>
            <div class="mb-3"><label class="form-label">Fahrzeug</label>
                <select class="form-select" @bind="_rVehicleId"><option value="0">— Anderes/Freitext —</option>@foreach (var v in _vehicles) { <option value="@v.Id">@v.Name</option> }</select>
            </div>
            @if (_rVehicleId == 0) { <div class="mb-3"><label class="form-label">Fahrzeug (Freitext)</label><input class="form-control" @bind="_rCustom" /></div> }
            <div class="mb-3 position-relative">
                <label class="form-label">Deine Mitgliedsnummer</label>
                <input class="form-control" value="@_rNumber" placeholder="Nummer eingeben oder Namen suchen…" @oninput="OnReportInput" />
                @if (_reportResults.Count > 0)
                {
                    <div class="list-group position-absolute w-100 shadow" style="z-index:1050; max-height:200px; overflow-y:auto;">
                        @foreach (var m in _reportResults)
                        {
                            <button type="button" class="list-group-item list-group-item-action py-1 px-2 small" @onclick="() => SelectReportMember(m)">
                                @m.Name <span class="text-muted">(@m.Number)</span>
                            </button>
                        }
                    </div>
                }
            </div>
            @if (_rError is not null) { <div class="alert alert-danger py-2">@_rError</div> }
        </div>
        <div class="modal-footer"><button class="btn btn-secondary" @onclick="() => _showReport = false">Abbrechen</button><button class="btn btn-primary" @onclick="Report" disabled="@_saving">Melden</button></div>
    </div></div></div>
}

@if (_detail is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)"><div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-sm-down modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Mangel-Detail</h5><button class="btn-close" @onclick="() => _detail = null"></button></div>
        <div class="modal-body">
            <p><strong>@_detail.Vehicle</strong> — @Badge(_detail.Status)</p>
            <p>@_detail.Description</p>
            <p class="text-muted small mb-1">Gemeldet @_detail.ReportedAt.ToString("dd.MM.yyyy HH:mm") von @_detail.ReportedByName</p>
            @if (_detail.ResolvedAt.HasValue)
            {
                <p class="text-muted small">Erledigt am @_detail.ResolvedAt.Value.ToString("dd.MM.yyyy HH:mm")@(string.IsNullOrEmpty(_detail.ResolvedByName) ? "" : " durch " + _detail.ResolvedByName)</p>
            }
            <hr />
            <h6>Verlauf</h6>
            @if (_history.Count == 0) { <p class="text-muted small">Keine Statusänderungen.</p> }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var h in _history)
                    {
                        <li class="border-top py-2">
                            <div class="d-flex align-items-center flex-wrap" style="gap:6px;">@Badge(h.OldStatus) <i class="bi bi-arrow-right"></i> @Badge(h.NewStatus)</div>
                            <div class="small text-muted">@h.ChangedAt.ToString("dd.MM.yyyy HH:mm") · @h.ChangedByName</div>
                            @if (!string.IsNullOrEmpty(h.Comment)) { <div class="small" style="overflow-wrap:anywhere;">@h.Comment</div> }
                        </li>
                    }
                </ul>
            }
            @{
                <hr />
                <h6>Status ändern</h6>
                <div class="mb-2"><select class="form-select" @bind="_newStatus">
                    @foreach (var s in AllStatuses.Where(s => s != _detail.Status))
                    {
                        <option value="@s">@StatusLabel(s)</option>
                    }
                </select></div>
                <div class="mb-2"><input class="form-control" placeholder="Kommentar (optional)" @bind="_comment" /></div>
                <div class="mb-2 position-relative">
                    <input class="form-control" placeholder="Deine Mitgliedsnummer oder Name suchen…" value="@_scNumber" @oninput="OnStatusInput" />
                    @if (_statusResults.Count > 0)
                    {
                        <div class="list-group position-absolute w-100 shadow" style="z-index:1050; max-height:200px; overflow-y:auto;">
                            @foreach (var m in _statusResults)
                            {
                                <button type="button" class="list-group-item list-group-item-action py-1 px-2 small" @onclick="() => SelectStatusMember(m)">
                                    @m.Name <span class="text-muted">(@m.Number)</span>
                                </button>
                            }
                        </div>
                    }
                </div>
                @if (_scError is not null) { <div class="alert alert-danger py-2">@_scError</div> }
                <button class="btn btn-primary" @onclick="ChangeStatus" disabled="@_scBusy">Speichern</button>
            }
        </div>
    </div></div></div>
}

@code {
    private List<DefectDto>? _items;
    private List<VehDto> _vehicles = new();
    private string? _filter;

    private bool _showReport, _saving;
    private string _rDesc = "", _rCustom = "", _rNumber = "";
    private int _rVehicleId;
    private string? _rError;
    private List<MemberDto> _reportResults = new();
    private CancellationTokenSource? _reportSearchCts;

    private DefectDto? _detail;
    private List<HistDto> _history = new();
    private string _newStatus = "InProgress", _comment = "", _scNumber = "";
    private string? _scError;
    private bool _scBusy;
    private List<MemberDto> _statusResults = new();
    private CancellationTokenSource? _statusSearchCts;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try { _vehicles = await Http.GetFromJsonAsync<List<VehDto>>("client-api/vehicles-active") ?? new(); } catch { }
        await Load();
    }
    private async Task Load()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<DefectDto>>("client-api/defects");
            _loadError = null;
        }
        catch
        {
            // Ladefehler nicht als "keine Mängel" tarnen -> klarer Hinweis + erneut versuchen.
            _loadError = "Mängelliste konnte nicht geladen werden – erneut versuchen.";
        }
    }

    private void ShowReport() { _rDesc = ""; _rCustom = ""; _rNumber = ""; _rVehicleId = 0; _rError = null; _reportResults = new(); _showReport = true; }

    // Live-Suche direkt auf oninput (nicht keyup) -> auch iOS 12 mit Autokorrektur/Diktat zuverlaessig.
    private async Task OnReportInput(ChangeEventArgs e)
    {
        _rNumber = e.Value?.ToString() ?? "";
        _reportSearchCts?.Cancel();
        var q = _rNumber.Trim();
        if (q.Length < 2) { _reportResults = new(); return; }
        var cts = new CancellationTokenSource();
        _reportSearchCts = cts;
        var res = await SearchMembers(q, cts.Token);
        if (!cts.IsCancellationRequested) _reportResults = res;
    }

    private void SelectReportMember(MemberDto m)
    {
        _rNumber = m.Number;
        _reportResults = new();
    }

    private async Task Report()
    {
        _rError = null;
        if (string.IsNullOrWhiteSpace(_rDesc)) { _rError = "Beschreibung erforderlich."; return; }
        // Fahrzeug erforderlich: entweder ausgewähltes Fahrzeug oder Freitext.
        if (_rVehicleId == 0 && string.IsNullOrWhiteSpace(_rCustom)) { _rError = "Fahrzeug erforderlich – bitte auswählen oder Freitext eingeben."; return; }
        if (string.IsNullOrWhiteSpace(_rNumber)) { _rError = "Mitgliedsnummer erforderlich."; return; }
        _saving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("client-api/defects", new { Description = _rDesc, VehicleId = _rVehicleId, CustomVehicle = _rCustom, ReporterNumber = _rNumber });
            var r = await resp.Content.ReadFromJsonAsync<StatusDto>();
            if (r?.Status == "ok") { _showReport = false; await Load(); }
            else _rError = "Mitglied nicht gefunden.";
        }
        catch { _rError = "Melden fehlgeschlagen."; }
        finally { _saving = false; }
    }

    private async Task OpenDetail(DefectDto d)
    {
        _detail = d; _newStatus = d.Status switch { "Open" => "InProgress", "InProgress" => "Done", _ => "InProgress" }; _comment = ""; _scNumber = ""; _scError = null; _statusResults = new();
        try { _history = await Http.GetFromJsonAsync<List<HistDto>>($"client-api/defects/{d.Id}/history") ?? new(); } catch { _history = new(); }
    }

    private async Task OnStatusInput(ChangeEventArgs e)
    {
        _scNumber = e.Value?.ToString() ?? "";
        _statusSearchCts?.Cancel();
        var q = _scNumber.Trim();
        if (q.Length < 2) { _statusResults = new(); return; }
        var cts = new CancellationTokenSource();
        _statusSearchCts = cts;
        var res = await SearchMembers(q, cts.Token);
        if (!cts.IsCancellationRequested) _statusResults = res;
    }

    private void SelectStatusMember(MemberDto m)
    {
        _scNumber = m.Number;
        _statusResults = new();
    }

    private async Task ChangeStatus()
    {
        _scError = null;
        if (_detail is null) return;
        if (string.IsNullOrWhiteSpace(_scNumber)) { _scError = "Mitgliedsnummer erforderlich."; return; }
        if (_scBusy) return;
        _scBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"client-api/defects/{_detail.Id}/status", new { NewStatus = _newStatus, Comment = _comment, MemberNumber = _scNumber });
            var r = await resp.Content.ReadFromJsonAsync<StatusDto>();
            if (r?.Status == "ok") { _detail = null; await Load(); }
            else _scError = "Mitglied nicht gefunden.";
        }
        catch { _scError = "Speichern fehlgeschlagen."; }
        finally { _scBusy = false; }
    }

    // Live-Namenssuche über den anonymen Endpoint; q<2 -> leere Liste (serverseitig ebenso).
    private async Task<List<MemberDto>> SearchMembers(string? term, CancellationToken ct = default)
    {
        var q = (term ?? "").Trim();
        if (q.Length < 2) return new();
        try { return await Http.GetFromJsonAsync<List<MemberDto>>($"client-api/members/search?q={Uri.EscapeDataString(q)}", ct) ?? new(); }
        catch { return new(); }
    }

    private static readonly string[] AllStatuses = { "Open", "InProgress", "Done" };
    private string StatusLabel(string s) => s switch { "Open" => "Offen", "InProgress" => "In Arbeit", "Done" => "Erledigt", _ => s };
    private RenderFragment Badge(string s) =>@<span class="badge @(s == "Open" ? "bg-danger" : s == "InProgress" ? "bg-warning" : "bg-success")">@StatusLabel(s)</span>;

    private record DefectDto(int Id, string Description, string Vehicle, string Status, string ReportedByName, DateTime ReportedAt, string? ResolvedByName, DateTime? ResolvedAt);
    private record VehDto(int Id, string Name);
    private record HistDto(string OldStatus, string NewStatus, string ChangedByName, DateTime ChangedAt, string? Comment);
    private record StatusDto(string Status);
    private record MemberDto(int Id, string Name, string Number);
}
