@page "/kalender"
@layout MainLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject FeuerwehrListen.Client.Services.AppContextService AppCtx

<PageTitle>Kalender</PageTitle>

@* Bewusst ohne JS-Kalenderbibliothek: auf Alt-Geraeten laeuft die App im Blazor-Server-
   Modus (SignalR/Long-Polling) ohne WebAssembly. Das Monatsraster ist deshalb eine
   schlichte HTML-Tabelle, Monatswechsel laeuft ueber State (kein Link = keine
   Vollnavigation = kein neuer Circuit), und "heute" kommt aus der Serverzeit. *@

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col"><h1 class="mb-0">Kalender</h1></div>
        <div class="col-auto"><button class="btn btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle"></i> Neuer Termin</button></div>
    </div>

    <div class="card mb-3"><div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth" title="Voriger Monat">&laquo;</button>
                <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="Today">Heute</button>
                <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="NextMonth" title="Naechster Monat">&raquo;</button>
            </div>
            <h4 class="mb-0">@MonthName(_month.Month) @_month.Year</h4>
            <div>
                @if (_loading) { <span class="spinner-border spinner-border-sm"></span> }
            </div>
        </div>
    </div></div>

    @if (_error is not null) { <div class="alert alert-danger">@_error</div> }

    <div class="table-responsive">
        <table class="table table-bordered mb-0" style="table-layout:fixed;">
            <thead>
                <tr>
                    @foreach (var d in new[] { "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So" })
                    {
                        <th class="text-center small">@d</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var week in Weeks())
                {
                    <tr>
                        @foreach (var day in week)
                        {
                            var isCurrentMonth = day.Month == _month.Month;
                            var isToday = day.Date == _serverToday.Date;
                            var dayItems = ItemsOn(day);
                            var isSelected = _selected?.Date == day.Date;
                            @* Ein onclick pro TAG, nicht pro Termin: im Server-Modus ist
                               jeder Handler ein Long-Polling-Roundtrip. *@
                            <td class="p-1 align-top @(isSelected ? "table-active" : "")"
                                style="height:88px; cursor:pointer; @(isCurrentMonth ? "" : "background-color:#f8f9fa;")"
                                @onclick="() => SelectDay(day)">
                                <div class="small @(isToday ? "fw-bold text-danger" : (isCurrentMonth ? "" : "text-muted"))">
                                    @day.Day@(isToday ? " •" : "")
                                </div>
                                @foreach (var it in dayItems.Take(3))
                                {
                                    <div class="small text-truncate" style="line-height:1.2;" title="@it.Title">
                                        <span style="color:@ColorOf(it.Kind);">&#9679;</span>
                                        <span>@ShortTime(it)</span> @it.Title
                                    </div>
                                }
                                @if (dayItems.Count > 3)
                                {
                                    <div class="small text-muted">+@(dayItems.Count - 3) weitere</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-2 small text-muted">
        <span style="color:#C77700;">&#9679;</span> Wache
        <span class="ms-2" style="color:#B22222;">&#9679;</span> Dienst
        <span class="ms-2" style="color:#0d6efd;">&#9679;</span> Veranstaltung
        <span class="ms-2" style="color:#198754;">&#9679;</span> Fahrzeug
        <span class="ms-2" style="color:#6f42c1;">&#9679;</span> Raum
        <span class="ms-2" style="color:#6c757d;">&#9679;</span> Geplante Liste
    </div>

    @if (_selected is DateTime sel)
    {
        <div class="card mt-3"><div class="card-body">
            <h5>@WeekdayName(sel.DayOfWeek), @sel.ToString("dd.MM.yyyy")</h5>
            @{ var list = ItemsOn(sel); }
            @if (list.Count == 0)
            {
                <p class="text-muted mb-0">Keine Termine an diesem Tag.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var it in list)
                    {
                        @* Ganze Zeile anklickbar: ein Handler pro Eintrag statt mehrerer -
                           im Server-Modus ist jeder Klick ein Netz-Roundtrip. *@
                        <li class="list-group-item list-group-item-action px-0" style="cursor:pointer;" @onclick="() => OpenDetail(it)">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span style="color:@ColorOf(it.Kind);">&#9679;</span>
                                    <strong>@it.Title</strong>
                                    <span class="badge bg-light text-dark ms-1">@KindLabel(it.Kind)</span>
                                    @if (it.PendingApprovals > 0) { <span class="badge bg-warning text-dark ms-1">Freigabe offen</span> }
                                    @if (it.Status == "Abgelehnt") { <span class="badge bg-danger ms-1">Abgelehnt</span> }
                                    <div class="small text-muted">
                                        @(it.AllDay ? "ganztägig" : $"{it.Start:HH:mm} – {it.End:HH:mm}")
                                        @if (!string.IsNullOrWhiteSpace(it.Location)) { <text> · @it.Location</text> }
                                        @if (!string.IsNullOrWhiteSpace(it.RequestedBy)) { <text> · @it.RequestedBy</text> }
                                    </div>
                                </div>
                                <span class="text-muted small">Details <i class="bi bi-chevron-right"></i></span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div></div>
    }
</div>

@if (_showCreate)
{
    <div class="modal fade show" style="display:block; background-color:rgba(0,0,0,0.5);" @onclick="() => _showCreate = false">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Neuer Termin</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCreate = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Art</label>
                        <select class="form-select" @bind="_fType">
                            <option value="Veranstaltung">Veranstaltung</option>
                            <option value="Dienst">Dienst (mit Anwesenheitsliste)</option>
                            <option value="Fahrzeugbuchung">Fahrzeugbuchung</option>
                            <option value="Raumbuchung">Raumbuchung</option>
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label">Titel / Anlass</label><input class="form-control" @bind="_fTitle" /></div>
                    @if (_fType == "Dienst")
                    {
                        <div class="mb-2">
                            <label class="form-label">Einheit</label>
                            <select class="form-select" @bind="_fUnitNumber">
                                <option value="">Keine Zuordnung</option>
                                @foreach (var u in _unitLabels)
                                {
                                    <option value="@u.Number">@u.Label</option>
                                }
                            </select>
                            <div class="form-text">
                                Die Anwesenheitsliste wird kurz vor Beginn automatisch für diese Einheit geöffnet.
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6 mb-2"><label class="form-label">Beginn</label><input type="datetime-local" class="form-control" @bind="_fStart" /></div>
                        <div class="col-md-6 mb-2"><label class="form-label">Ende</label><input type="datetime-local" class="form-control" @bind="_fEnd" /></div>
                    </div>
                    <div class="mb-2"><label class="form-label">Ort (optional)</label><input class="form-control" @bind="_fLocation" /></div>
                    <div class="mb-2"><label class="form-label">Bemerkung (optional)</label><input class="form-control" @bind="_fDescription" /></div>

                    @* Identifikation ist Pflicht - Buchen geht ohne Login, aber nicht anonym. *@
                    <div class="mb-2 position-relative">
                        <label class="form-label">Dein Name oder deine Mitgliedsnummer <span class="text-danger">*</span></label>
                        <input class="form-control" value="@_fRequestedBy" @oninput="OnRequesterInput" autocomplete="off" placeholder="Nummer eingeben oder Namen suchen…" />
                        @if (_requesterSuggestions is { Count: > 0 })
                        {
                            <div class="list-group position-absolute w-100 shadow" style="z-index:1060; max-height:200px; overflow-y:auto;">
                                @foreach (var m in _requesterSuggestions)
                                {
                                    <button type="button" class="list-group-item list-group-item-action py-1 px-2 small" @onclick="() => PickRequester(m)">
                                        @m.Name <span class="text-muted">(@m.Number)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Deine E-Mail (optional)</label>
                        <input class="form-control" @bind="_fEmail" placeholder="für die Rückmeldung zur Freigabe" />
                    </div>

                    @if (_resources is not null)
                    {
                        @if (_resources.Vehicles.Count > 0)
                        {
                            <div class="mb-2">
                                <label class="form-label">Fahrzeuge (optional)</label>
                                @foreach (var v in _resources.Vehicles)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="veh@(v.Id)"
                                               checked="@_fVehicles.Contains(v.Id)"
                                               @onchange="e => ToggleVehicle(v.Id, (bool)e.Value!)" />
                                        <label class="form-check-label" for="veh@(v.Id)">
                                            @v.Name <span class="text-muted small">(@v.CallSign)</span>
                                            @if (v.RequiresApproval) { <span class="badge bg-warning text-dark ms-1">Freigabe nötig</span> }
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        @if (_resources.Rooms.Count > 0)
                        {
                            <div class="mb-2">
                                <label class="form-label">Räume (optional)</label>
                                @foreach (var r in _resources.Rooms)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="room@(r.Id)"
                                               checked="@_fRooms.Contains(r.Id)"
                                               @onchange="e => ToggleRoom(r.Id, (bool)e.Value!)" />
                                        <label class="form-check-label" for="room@(r.Id)">
                                            @r.Name
                                            @if (r.RequiresApproval) { <span class="badge bg-warning text-dark ms-1">Bestätigung nötig</span> }
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    }

                    @if (_formError is not null) { <div class="alert alert-danger py-2 mb-0">@_formError</div> }
                    @if (_conflicts is { Count: > 0 })
                    {
                        <div class="alert alert-warning py-2 mb-0">
                            <strong>Zeitraum bereits belegt:</strong>
                            <ul class="mb-0">
                                @foreach (var c in _conflicts)
                                {
                                    <li>@c.Resource – „@c.Title" (@c.Start.ToString("dd.MM. HH:mm") – @c.End.ToString("HH:mm"))</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showCreate = false">Abbrechen</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Speichern
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===================== Termin-Details ===================== *@
@if (_detail is not null)
{
    <div class="modal fade show" style="display:block; background-color:rgba(0,0,0,0.5); cursor:pointer;" @onclick="CloseDetail">
        <div class="modal-dialog modal-lg modal-dialog-centered" style="cursor:default;" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span style="color:@ColorOf(_detail.Kind);">&#9679;</span>
                        @_detail.Title
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    @if (_editing)
                    {
                        <div class="mb-2"><label class="form-label">Titel</label><input class="form-control" @bind="_eTitle" /></div>
                        <div class="row">
                            <div class="col-md-6 mb-2"><label class="form-label">Beginn</label><input type="datetime-local" class="form-control" @bind="_eStart" /></div>
                            <div class="col-md-6 mb-2"><label class="form-label">Ende</label><input type="datetime-local" class="form-control" @bind="_eEnd" /></div>
                        </div>
                        <div class="mb-2"><label class="form-label">Ort</label><input class="form-control" @bind="_eLocation" /></div>
                        <div class="mb-2"><label class="form-label">Bemerkung</label><input class="form-control" @bind="_eDescription" /></div>
                        @if (_full?.Type == "Dienst")
                        {
                            <div class="mb-2">
                                <label class="form-label">Einheit</label>
                                <select class="form-select" @bind="_eUnitNumber">
                                    <option value="">Keine Zuordnung</option>
                                    @foreach (var u in _unitLabels)
                                    {
                                        <option value="@u.Number">@u.Label</option>
                                    }
                                </select>
                                @if (_full?.AttendanceListId is not null)
                                {
                                    <div class="form-text text-warning">
                                        Die Anwesenheitsliste wurde bereits geöffnet – eine Änderung der Einheit
                                        wirkt sich darauf nicht mehr aus.
                                    </div>
                                }
                            </div>
                        }
                        @if (_detail.SeriesId is not null)
                        {
                            <div class="alert alert-info py-2 mb-0">
                                Teil einer Serie. Änderungen gelten nur für diesen Termin – er wird danach
                                von der Serie nicht mehr überschrieben.
                            </div>
                        }
                    }
                    else
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Art</dt>
                            <dd class="col-sm-8">@KindLabel(_detail.Kind)</dd>

                            <dt class="col-sm-4">Zeitraum</dt>
                            <dd class="col-sm-8">
                                @(_detail.AllDay
                                    ? $"{_detail.Start:dd.MM.yyyy} (ganztägig)"
                                    : $"{_detail.Start:dd.MM.yyyy HH:mm} – {_detail.End:dd.MM.yyyy HH:mm}")
                            </dd>

                            @if (!string.IsNullOrWhiteSpace(_detail.Location))
                            {
                                <dt class="col-sm-4">Ort</dt>
                                <dd class="col-sm-8">@_detail.Location</dd>
                            }

                            @if (_full is not null)
                            {
                                @if (!string.IsNullOrWhiteSpace(_full.Description))
                                {
                                    <dt class="col-sm-4">Bemerkung</dt>
                                    <dd class="col-sm-8">@_full.Description</dd>
                                }
                                <dt class="col-sm-4">Angefragt von</dt>
                                <dd class="col-sm-8">@_full.RequestedBy</dd>

                                @if (!string.IsNullOrWhiteSpace(_full.UnitLabel))
                                {
                                    <dt class="col-sm-4">Einheit</dt>
                                    <dd class="col-sm-8">@_full.UnitLabel</dd>
                                }

                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    @if (_full.Status == "Bestaetigt") { <span class="badge bg-success">bestätigt</span> }
                                    else if (_full.Status == "Angefragt") { <span class="badge bg-warning text-dark">Freigabe offen</span> }
                                    else if (_full.Status == "Abgelehnt") { <span class="badge bg-danger">abgelehnt</span> }
                                    else { <span class="badge bg-secondary">storniert</span> }
                                    @if (_full.SeriesId is not null) { <span class="badge bg-light text-dark ms-1">Serie</span> }
                                </dd>

                                @if (_full.Resources is { Count: > 0 })
                                {
                                    <dt class="col-sm-4">Fahrzeuge / Räume</dt>
                                    <dd class="col-sm-8">
                                        @foreach (var r in _full.Resources)
                                        {
                                            <div>
                                                <strong>@r.Name</strong> <span class="text-muted small">(@r.Kind)</span>
                                                @if (r.Status == "Freigegeben") { <span class="badge bg-success ms-1">freigegeben</span> }
                                                else if (r.Status == "Angefragt") { <span class="badge bg-warning text-dark ms-1">Freigabe offen</span> }
                                                else if (r.Status == "Abgelehnt") { <span class="badge bg-danger ms-1">abgelehnt</span> }
                                                @if (!string.IsNullOrWhiteSpace(r.ApprovedBy))
                                                {
                                                    <div class="small text-muted">
                                                        @r.ApprovedBy, @r.ApprovedAt?.ToString("dd.MM.yyyy HH:mm")
                                                        @if (!string.IsNullOrWhiteSpace(r.Comment)) { <text> – @r.Comment</text> }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </dd>
                                }

                                @if (_full.AttendanceListId is int alid)
                                {
                                    <dt class="col-sm-4">Anwesenheitsliste</dt>
                                    <dd class="col-sm-8"><a href="/attendance/@alid">Liste öffnen</a></dd>
                                }
                            }
                            else if (_loadingDetail)
                            {
                                <dt class="col-sm-4">Weitere Angaben</dt>
                                <dd class="col-sm-8"><em>Lade…</em></dd>
                            }
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(_detail.Href))
                        {
                            <a class="btn btn-outline-primary mt-3" href="@_detail.Href">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Zugehörige Seite öffnen
                            </a>
                        }
                    }

                    @if (_detailError is not null) { <div class="alert alert-danger py-2 mt-3 mb-0">@_detailError</div> }
                    @if (_confirmDelete)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            Diesen Termin wirklich löschen? Das lässt sich nicht rückgängig machen.
                            <div class="mt-2">
                                <button class="btn btn-danger btn-sm me-2" @onclick="DeleteEvent" disabled="@_detailBusy">Ja, löschen</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDelete = false">Abbrechen</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @* Ändern und Löschen nur für Verwaltung, und nur für echte Kalendertermine. *@
                    <AuthorizeView Roles="Admin">
                        @if (IsCalendarEvent(_detail.Kind))
                        {
                            @if (_editing)
                            {
                                <button class="btn btn-primary" @onclick="SaveEdit" disabled="@_detailBusy">Speichern</button>
                                <button class="btn btn-secondary" @onclick="() => _editing = false">Abbrechen</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary me-auto" @onclick="StartEdit">
                                    <i class="bi bi-pencil me-1"></i>Bearbeiten
                                </button>
                                <button class="btn btn-outline-danger" @onclick="() => _confirmDelete = true">
                                    <i class="bi bi-trash me-1"></i>Löschen
                                </button>
                            }
                        }
                    </AuthorizeView>
                    @if (!_editing)
                    {
                        <button class="btn btn-secondary" @onclick="CloseDetail">Schließen</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_info is not null)
{
    @* Mit Schliessen-Knopf UND Selbstabbau: ohne beides blieb der Hinweis dauerhaft stehen. *@
    <div class="alert alert-success position-fixed d-flex justify-content-between align-items-start"
         style="bottom:16px; left:16px; right:16px; z-index:1080;">
        <span>@_info</span>
        <button type="button" class="btn-close ms-3" aria-label="Schließen" @onclick="() => _info = null"></button>
    </div>
}

@code {
    private DateTime _month = new(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime _serverToday = DateTime.Now;
    private DateTime? _selected;
    private List<CalItem> _items = new();
    private bool _loading, _saving;
    private string? _error, _formError, _info;

    private bool _showCreate;
    private string _fType = "Veranstaltung", _fTitle = "", _fLocation = "", _fDescription = "", _fRequestedBy = "", _fEmail = "";
    private string _fUnitNumber = "";
    private List<FeuerwehrListen.Client.Models.UnitLabel> _unitLabels = new();
    private DateTime _fStart = DateTime.Now.Date.AddHours(18);
    private DateTime _fEnd = DateTime.Now.Date.AddHours(20);
    private readonly HashSet<int> _fVehicles = new();
    private readonly HashSet<int> _fRooms = new();
    private ResourcesDto? _resources;
    private List<ConflictDto>? _conflicts;
    private List<MemberChoice>? _requesterSuggestions;
    private CancellationTokenSource? _requesterCts;

    // Detail-Fenster
    private CalItem? _detail;
    private EventDetailDto? _full;
    private bool _loadingDetail, _detailBusy, _confirmDelete, _editing;
    private string? _detailError;
    private string _eTitle = "", _eLocation = "", _eDescription = "", _eUnitNumber = "";
    private DateTime _eStart, _eEnd;

    // Laufende Nummer, damit ein aelterer Ausblend-Auftrag einen neueren Hinweis nicht loescht.
    private int _infoSeq;

    /// <summary>Hinweis anzeigen und nach einigen Sekunden selbst wieder abbauen.</summary>
    private void ShowInfo(string text, int seconds = 8)
    {
        _info = text;
        var seq = ++_infoSeq;
        _ = Task.Run(async () =>
        {
            await Task.Delay(seconds * 1000);
            // Ist der Circuit inzwischen weg, wirft InvokeAsync. Ohne dieses catch
            // waere das eine unbeobachtete Ausnahme im Hintergrund.
            try
            {
                await InvokeAsync(() =>
                {
                    if (_infoSeq == seq) { _info = null; StateHasChanged(); }
                });
            }
            catch { }
        });
    }

    // Wachen und geplante Listen sind keine Kalendertermine - sie lassen sich hier
    // nicht bearbeiten oder loeschen.
    private static bool IsCalendarEvent(string kind) =>
        kind is "dienst" or "veranstaltung" or "fahrzeug" or "raum";

    private async Task OpenDetail(CalItem it)
    {
        _detail = it; _full = null; _detailError = null;
        _confirmDelete = false; _editing = false;
        if (!IsCalendarEvent(it.Kind)) return;

        _loadingDetail = true;
        try { _full = await Http.GetFromJsonAsync<EventDetailDto>($"client-api/calendar/events/{it.Id}"); }
        catch { _detailError = "Details konnten nicht geladen werden."; }
        finally { _loadingDetail = false; }
    }

    private void CloseDetail()
    {
        _detail = null; _full = null; _editing = false; _confirmDelete = false; _detailError = null;
    }

    private void StartEdit()
    {
        if (_detail is null) return;
        _eTitle = _full?.Title ?? _detail.Title;
        _eLocation = _full?.Location ?? _detail.Location ?? "";
        _eDescription = _full?.Description ?? "";
        _eStart = _full?.Start ?? _detail.Start;
        _eEnd = _full?.End ?? _detail.End;
        _eUnitNumber = _full?.UnitNumber?.ToString() ?? "";
        _detailError = null;
        _editing = true;
    }

    private async Task SaveEdit()
    {
        if (_detail is null) return;
        if (string.IsNullOrWhiteSpace(_eTitle)) { _detailError = "Bitte einen Titel angeben."; return; }
        if (_eEnd <= _eStart) { _detailError = "Das Ende muss nach dem Beginn liegen."; return; }
        _detailBusy = true; _detailError = null;
        try
        {
            var body = new
            {
                Title = _eTitle,
                Description = _eDescription,
                Location = _eLocation,
                Start = _eStart,
                End = _eEnd,
                AllDay = false,
                // Bestehende Einheit mitsenden - sonst wuerde sie beim Speichern geleert.
                UnitNumber = string.IsNullOrEmpty(_eUnitNumber) ? (int?)null : int.Parse(_eUnitNumber)
            };
            var resp = await Http.PutAsJsonAsync($"client-api/calendar/events/{_detail.Id}", body);
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized) { _detailError = "Sitzung abgelaufen – bitte neu anmelden."; return; }
            if (!resp.IsSuccessStatusCode) { _detailError = "Speichern fehlgeschlagen."; return; }
            _editing = false;
            CloseDetail();
            await Load();
            ShowInfo("Termin geändert.");
        }
        catch { _detailError = "Speichern fehlgeschlagen."; }
        finally { _detailBusy = false; }
    }

    private async Task DeleteEvent()
    {
        if (_detail is null) return;
        _detailBusy = true; _detailError = null;
        try
        {
            var resp = await Http.DeleteAsync($"client-api/admin/calendar/events/{_detail.Id}");
            if (resp.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            { _detailError = "Dafür fehlen die Rechte – bitte als Verwaltung anmelden."; return; }
            if (!resp.IsSuccessStatusCode) { _detailError = "Löschen fehlgeschlagen."; return; }
            CloseDetail();
            await Load();
            ShowInfo("Termin gelöscht.");
        }
        catch { _detailError = "Löschen fehlgeschlagen."; }
        finally { _detailBusy = false; _confirmDelete = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Einheiten-Bezeichnungen kommen aus dem App-Kontext (dort gecacht).
        try { _unitLabels = (await AppCtx.GetAsync())?.UnitLabels ?? new(); } catch { }
        await Load();
    }

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            var from = _month.AddDays(-7);
            var to = _month.AddMonths(1).AddDays(7);
            var resp = await Http.GetFromJsonAsync<CalendarResponse>(
                $"client-api/calendar?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}");
            if (resp is not null)
            {
                _items = resp.Items ?? new();
                _serverToday = resp.ServerTime;
            }
        }
        catch { _error = "Kalender konnte nicht geladen werden."; }
        finally { _loading = false; }
    }

    private async Task PrevMonth() { _month = _month.AddMonths(-1); _selected = null; await Load(); }
    private async Task NextMonth() { _month = _month.AddMonths(1); _selected = null; await Load(); }
    private async Task Today() { _month = new DateTime(_serverToday.Year, _serverToday.Month, 1); _selected = _serverToday.Date; await Load(); }
    private void SelectDay(DateTime d) => _selected = d.Date;

    /// <summary>Wochen des Monatsrasters, immer montags beginnend.</summary>
    private List<List<DateTime>> Weeks()
    {
        var first = _month;
        var offset = ((int)first.DayOfWeek + 6) % 7; // Montag = 0
        var start = first.AddDays(-offset);
        var weeks = new List<List<DateTime>>();
        for (var w = 0; w < 6; w++)
        {
            var week = new List<DateTime>();
            for (var d = 0; d < 7; d++) week.Add(start.AddDays(w * 7 + d));
            weeks.Add(week);
            // Letzte Zeile weglassen, wenn sie komplett im Folgemonat liegt.
            if (w >= 4 && week[6] > _month.AddMonths(1).AddDays(-1)) break;
        }
        return weeks;
    }

    private List<CalItem> ItemsOn(DateTime day) =>
        _items.Where(i => i.Start.Date <= day.Date && i.End.Date >= day.Date)
              .OrderBy(i => i.Start)
              .ToList();

    private static string ShortTime(CalItem i) => i.AllDay ? "" : i.Start.ToString("HH:mm");

