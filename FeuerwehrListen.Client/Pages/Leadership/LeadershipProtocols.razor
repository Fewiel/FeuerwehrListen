@page "/fuehrungskreis"
@page "/fuehrungskreis/termin/{EventId:int}"
@layout MainLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Führungskreis – Protokolle</PageTitle>

<AuthGuard>
    <div class="container-fluid mt-4" style="max-width:1100px;">
        <div class="d-flex flex-wrap align-items-end mb-3" style="gap:12px;">
            <div class="flex-grow-1">
                <h1 class="mb-1">Führungskreis</h1>
                <p class="text-muted mb-0">Sitzungen werden im Kalender angelegt (Typ „Führungskreis“) – das Protokoll entsteht automatisch.</p>
            </div>
            <a href="/fuehrungskreis/aufgaben" class="btn btn-outline-secondary"><i class="bi bi-check2-square me-1"></i>Aufgaben</a>
            <a href="/kalender" class="btn btn-primary"><i class="bi bi-calendar-plus me-1"></i>Sitzung anlegen</a>
        </div>

        @if (_error is not null) { <div class="alert alert-danger">@_error</div> }
        else if (_data is null) { <p><em>Lade…</em></p> }
        else
        {
            <h2 class="h5 mt-2">Anstehend</h2>
            @if (_data.Upcoming.Count == 0) { <p class="text-muted">Keine Sitzungen geplant.</p> }
            @foreach (var p in _data.Upcoming) { @Row(p) }

            @if (_data.Past.Count > 0)
            {
                <h2 class="h5 mt-4">Vergangen</h2>
                @foreach (var p in _data.Past) { @Row(p) }
            }
        }
    </div>
</AuthGuard>

@code {
    [Parameter] public int? EventId { get; set; }

    private ListDto? _data;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // Aus dem Kalender: Termin -> zugehoeriges Protokoll oeffnen.
            if (EventId is int eid)
            {
                var r = await Http.GetFromJsonAsync<IdDto>($"client-api/leadership/protocols/by-event/{eid}");
                if (r is not null) { Nav.NavigateTo($"/fuehrungskreis/protokoll/{r.Id}", replace: true); return; }
            }
            _data = await Http.GetFromJsonAsync<ListDto>("client-api/leadership/protocols");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound) { _error = "Diese Sitzung gibt es nicht oder sie ist für dich nicht sichtbar."; }
        catch { _error = "Protokolle konnten nicht geladen werden."; }
    }

    private RenderFragment Row(ProtocolDto p) => __builder =>
    {
        <a href="/fuehrungskreis/protokoll/@p.Id" class="card mb-2 text-decoration-none text-reset">
            <div class="card-body d-flex align-items-center" style="gap:16px;">
                <div style="width:60px;text-align:center;border-radius:10px;background:#C8102E;color:#fff;padding:6px 0;">
                    <div style="font-size:.75rem;font-weight:600;">@p.Start.ToString("MMM", new System.Globalization.CultureInfo("de-DE")).ToUpperInvariant()</div>
                    <div style="font-size:1.5rem;font-weight:700;line-height:1.1;">@p.Start.Day</div>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">@p.Title</div>
                    <div class="small text-muted">@p.Start.ToString("dddd, dd.MM.yyyy · HH:mm", new System.Globalization.CultureInfo("de-DE")) Uhr@(string.IsNullOrWhiteSpace(p.Location) ? "" : " · " + p.Location) · @p.Items Punkte</div>
                </div>
                <span class="badge" style="background:#F1EAFA;color:#6B3FA0;">@p.CircleLabel</span>
                <span class="badge @StatusClass(p.Status)">@StatusLabel(p.Status)</span>
            </div>
        </a>
    };

    public static string StatusLabel(string s) => s switch { "Laeuft" => "Sitzung läuft", "Abgeschlossen" => "Abgeschlossen", _ => "In Vorbereitung" };
    private static string StatusClass(string s) => s switch { "Laeuft" => "bg-success", "Abgeschlossen" => "bg-secondary", _ => "bg-warning text-dark" };

    private record IdDto(int Id);
    private record ProtocolDto(int Id, string Title, DateTime Start, string? Location, int Circle, string CircleLabel, string Status, int Items);
    private record ListDto(List<ProtocolDto> Upcoming, List<ProtocolDto> Past);
}
