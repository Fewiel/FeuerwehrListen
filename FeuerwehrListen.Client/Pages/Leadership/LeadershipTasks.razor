@page "/fuehrungskreis/aufgaben"
@layout MainLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Führungskreis – Aufgaben</PageTitle>

<AuthGuard>
    <div class="container-fluid mt-4" style="max-width:1200px;">
        <div class="d-flex flex-wrap align-items-end mb-3" style="gap:12px;">
            <div class="flex-grow-1">
                <h1 class="mb-1">Aufgaben</h1>
                <p class="text-muted mb-0">Erledigte Aufgaben landen automatisch als Punkt in der nächsten Sitzung des Kreises.</p>
            </div>
            <a href="/fuehrungskreis" class="btn btn-outline-secondary"><i class="bi bi-journal-text me-1"></i>Protokolle</a>
            <button class="btn btn-primary" @onclick="ShowAdd"><i class="bi bi-plus-lg me-1"></i>Neue Aufgabe</button>
        </div>

        <div class="d-flex flex-wrap mb-3" style="gap:8px;">
            <button class="btn @(_status == "open" && !_mine ? "btn-dark" : "btn-outline-secondary") rounded-pill" @onclick='() => SetFilter("open", false)'>Offen</button>
            <button class="btn @(_mine ? "btn-dark" : "btn-outline-secondary") rounded-pill" @onclick='() => SetFilter("open", true)'>Meine</button>
            <button class="btn @(_status == "done" ? "btn-dark" : "btn-outline-secondary") rounded-pill" @onclick='() => SetFilter("done", false)'>Erledigt</button>
            <span class="border-start mx-1"></span>
            <button class="btn @(_circleFilter == 2 ? "btn-dark" : "btn-outline-secondary") rounded-pill" @onclick="() => ToggleCircle(2)">Kleiner FK</button>
            <button class="btn @(_circleFilter == 1 ? "btn-dark" : "btn-outline-secondary") rounded-pill" @onclick="() => ToggleCircle(1)">Großer FK</button>
        </div>

        @if (_form)
        {
            <div class="card mb-3"><div class="card-body">
                <h5 class="card-title">@(_editId is null ? "Neue Aufgabe" : "Aufgabe bearbeiten")</h5>
                <div class="row g-2">
                    <div class="col-md-6"><label class="form-label">Aufgabe</label><input class="form-control" @bind="_title" /></div>
                    <div class="col-md-3">
                        <label class="form-label">Kreis</label>
                        <select class="form-select" @bind="_circle">
                            <option value="1">Großer Führungskreis</option>
                            <option value="2">Kleiner Führungskreis</option>
                        </select>
                    </div>
                    <div class="col-md-3"><label class="form-label">Fällig am</label><input type="date" class="form-control" @bind="_due" /></div>
                    <div class="col-md-6">
                        <label class="form-label">Verantwortlich</label>
                        <select class="form-select" @bind="_assignee">
                            <option value="0">– offen –</option>
                            @foreach (var m in _members.Where(m => m.Circle >= _circle)) { <option value="@m.Id">@m.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-6"><label class="form-label">Beschreibung</label><input class="form-control" @bind="_description" /></div>
                </div>
                @if (_error is not null) { <div class="alert alert-danger py-2 mt-2 mb-0">@_error</div> }
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="Save">Speichern</button>
                    <button class="btn btn-secondary" @onclick="() => _form = false">Abbrechen</button>
                </div>
            </div></div>
        }

        <div class="card"><div class="card-body p-0">
            @if (_tasks is null) { <p class="p-3 mb-0"><em>Lade…</em></p> }
            else if (Visible.Count == 0) { <p class="p-3 mb-0 text-muted">Keine Aufgaben.</p> }
            else
            {
                <div class="table-responsive"><table class="table mb-0 align-middle">
                    <thead><tr><th style="width:48px;"></th><th>Aufgabe</th><th>Verantwortlich</th><th>Fällig</th><th>Kreis</th><th>Herkunft</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var t in Visible)
                        {
                            <tr style="@(t.Done ? "background:#F3FAF5;" : "")">
                                <td>
                                    <button class="btn btn-sm @(t.Done ? "btn-success" : "btn-outline-secondary")" style="width:34px;height:34px;"
                                            title="@(t.Done ? "Wieder öffnen" : "Erledigt")" aria-label="@(t.Done ? "Wieder öffnen" : "Als erledigt markieren")" @onclick="() => ToggleDone(t)">
                                        @(t.Done ? "✓" : "")
                                    </button>
                                </td>
                                <td>
                                    <div class="fw-semibold" style="@(t.Done ? "text-decoration:line-through;color:#5C5853;" : "")">@t.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="small text-muted">@t.Description</div> }
                                    @if (t.Done && t.FollowUp is not null) { <div class="small fw-semibold" style="color:#1E7A3C;">→ als Punkt in @t.FollowUp übernommen</div> }
                                </td>
                                <td>@(t.Assignee ?? "–")</td>
                                <td style="@(t.Overdue ? "color:#B8001F;font-weight:700;" : "")">@(t.Due?.ToString("dd.MM.yyyy") ?? "–")</td>
                                <td><span class="badge" style="background:#F1EAFA;color:#6B3FA0;">@(t.Circle == 2 ? "Klein" : "Groß")</span></td>
                                <td class="small">@t.Origin</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(t)" aria-label="Bearbeiten"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(t)" aria-label="Löschen"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    </div>
</AuthGuard>

@code {
    private List<TaskDto>? _tasks;
    private List<MemberDto> _members = new();
    private string _status = "open";
    private bool _mine;
    private int _circleFilter;

    private bool _form;
    private int? _editId;
    private string _title = "", _description = "";
    private int _circle = 1, _assignee;
    private DateTime? _due;
    private string? _error;

    private List<TaskDto> Visible => (_tasks ?? new())
        .Where(t => !_mine || t.Mine)
        .Where(t => _circleFilter == 0 || t.Circle == _circleFilter)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try { _members = await Http.GetFromJsonAsync<List<MemberDto>>("client-api/leadership/members?circle=1") ?? new(); } catch { }
        await Load();
    }

    private async Task Load()
    {
        try { _tasks = await Http.GetFromJsonAsync<List<TaskDto>>($"client-api/leadership/tasks?status={_status}"); }
        catch { _tasks = new(); }
    }

    private async Task SetFilter(string status, bool mine)
    {
        _mine = mine;
        if (_status != status) { _status = status; await Load(); }
    }

    private void ToggleCircle(int c) => _circleFilter = _circleFilter == c ? 0 : c;

    private void ShowAdd()
    {
        _editId = null; _title = ""; _description = ""; _circle = 1; _assignee = 0; _due = null; _error = null; _form = true;
    }

    private void Edit(TaskDto t)
    {
        _editId = t.Id; _title = t.Title; _description = t.Description ?? ""; _circle = t.Circle; _assignee = t.AssigneeId ?? 0; _due = t.Due; _error = null; _form = true;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_title)) { _error = "Bitte eine Aufgabe eintragen."; return; }
        var body = new { Title = _title, Description = _description, Circle = _circle, AssigneeMemberId = _assignee == 0 ? (int?)null : _assignee, DueDate = _due };
        try
        {
            var resp = _editId is int id ? await Http.PutAsJsonAsync($"client-api/leadership/tasks/{id}", body) : await Http.PostAsJsonAsync("client-api/leadership/tasks", body);
            if (!resp.IsSuccessStatusCode) { _error = "Speichern fehlgeschlagen."; return; }
            _form = false;
            await Load();
        }
        catch { _error = "Speichern fehlgeschlagen."; }
    }

    private async Task ToggleDone(TaskDto t)
    {
        try { await Http.PostAsync($"client-api/leadership/tasks/{t.Id}/{(t.Done ? "reopen" : "done")}", null); } catch { }
        await Load();
    }

    private async Task Delete(TaskDto t)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Aufgabe „{t.Title}“ löschen?")) return;
        try { await Http.DeleteAsync($"client-api/leadership/tasks/{t.Id}"); } catch { }
        await Load();
    }

    private record MemberDto(int Id, string Name, int Circle);
    private record TaskDto(int Id, string Title, string? Description, int Circle, int? AssigneeId, string? Assignee, bool Mine,
        DateTime? Due, bool Overdue, bool Done, DateTime? CompletedAt, string Origin, string? FollowUp);
}
