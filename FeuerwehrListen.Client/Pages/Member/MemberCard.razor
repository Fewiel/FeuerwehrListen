@page "/mein/ausweis"
@layout MemberLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Dienstausweis</PageTitle>

<AuthGuard>
    @if (_loadError) { <div class="alert alert-danger">Ausweis konnte nicht geladen werden.</div> }
    else if (_me is null) { <p><em>Lade…</em></p> }
    else if (!_me.IsMember) { <div class="alert alert-info">Den Dienstausweis gibt es nur für Mitglieder-Konten.</div> }
    else
    {
        @if (!_me.Card.Valid)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-1"></i>
                @if (_me.Card.Revoked) { <text>Dieser Ausweis ist gesperrt. Bitte die Verwaltung ansprechen.</text> }
                else if (!_me.HasPhoto) { <text>Der Ausweis wird erst mit Lichtbild gültig. </text><a href="/mein/profil">Lichtbild hochladen</a> }
                else if (_me.Card.ValidUntil is DateTime vu && vu.Date < DateTime.Today) { <text>Der Ausweis ist am @vu.ToString("dd.MM.yyyy") abgelaufen.</text> }
                else { <text>Der Ausweis ist derzeit nicht gültig.</text> }
            </div>
        }

        <div class="@(_fullscreen ? "fwc-full" : "")">
            @if (_fullscreen)
            {
                <button type="button" class="fwc-close" aria-label="Vollbild schließen" @onclick="ExitFullscreen"><i class="bi bi-x-lg"></i></button>
            }
            <section class="fwc-card" aria-label="Dienstausweis">
                <div class="fwc-band">
                    <div>
                        <div class="fwc-org">@(_appName ?? "Feuerwehr")</div>
                        <div class="fwc-sub">Dienstausweis</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_logoUrl)) { <img src="@_logoUrl" alt="" class="fwc-logo" /> }
                </div>
                <div class="fwc-body">
                    <img src="@PhotoUrl" alt="Lichtbild" class="fwc-photo" />
                    <div class="fwc-fields">
                        <div><div class="fwm-label">Name</div><div class="fwc-name">@_me.FirstName @_me.LastName</div></div>
                        @if (_me.BirthDate is DateTime bd) { <div><div class="fwm-label">Geboren</div><div class="fwc-val">@bd.ToString("dd.MM.yyyy")</div></div> }
                        @if (!string.IsNullOrWhiteSpace(_me.Rank)) { <div><div class="fwm-label">Dienstgrad</div><div class="fwc-val">@_me.Rank</div></div> }
                        @if (!string.IsNullOrWhiteSpace(_me.Unit)) { <div><div class="fwm-label">Einheit</div><div class="fwc-val">@_me.Unit</div></div> }
                    </div>
                </div>
                <div class="fwc-row">
                    <div><div class="fwm-label">Ausweis-Nr.</div><div class="fwc-num">@_me.Number</div></div>
                    <div><div class="fwm-label">Gültig bis</div><div class="fwc-num">@(_me.Card.ValidUntil?.ToString("dd.MM.yyyy") ?? "unbefristet")</div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_me.IssuedBy))
                {
                    <div class="fwc-issuer"><span class="fwm-label">Ausgestellt von</span><div>@_me.IssuedBy</div></div>
                }
                <div class="fwc-qr">
                    @if (_me.Card.Issued)
                    {
                        <img src="client-api/me/card-qr?v=@_me.PhotoVersion" alt="QR-Code zur Echtheitsprüfung" />
                        <div><strong>Echtheit prüfen</strong><br />QR-Code scannen – zeigt Lichtbild und Gültigkeit dieses Ausweises.</div>
                    }
                    else
                    {
                        <div>Noch kein Ausweis ausgestellt.</div>
                    }
                </div>
            </section>
        </div>

        @if (!_fullscreen)
        {
            <button type="button" class="fwm-btn fwm-btn-outline mt-3" @onclick="EnterFullscreen">
                <i class="bi bi-arrows-fullscreen"></i> Vollbild zum Vorzeigen
            </button>
        }
    }
</AuthGuard>

<style>
    .fwc-card { background: #fff; border-radius: 16px; box-shadow: 0 6px 24px rgba(0,0,0,.10); overflow: hidden; max-width: 420px; margin-left: auto; margin-right: auto; }
    .fwc-band { background: #C8102E; color: #fff; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; }
    .fwc-org { font-weight: 800; font-size: 1.05rem; letter-spacing: .04em; text-transform: uppercase; }
    .fwc-sub { font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; opacity: .92; }
    .fwc-logo { height: 40px; width: auto; }
    .fwc-body { padding: 18px; display: flex; }
    .fwc-photo { width: 104px; height: 130px; object-fit: cover; border-radius: 8px; background: #E3E0DB; flex-shrink: 0; margin-right: 16px; }
    .fwc-fields > div { margin-bottom: 8px; }
    .fwc-name { font-size: 1.25rem; font-weight: 700; line-height: 1.2; }
    .fwc-val { font-weight: 500; }
    .fwc-row { margin-left: 18px; margin-right: 18px; padding-top: 12px; padding-bottom: 12px; border-top: 1px solid #ECE9E4; display: flex; }
    .fwc-row > div { flex: 1; }
    .fwc-num { font-weight: 600; font-variant-numeric: tabular-nums; }
    .fwc-issuer { margin-left: 18px; margin-right: 18px; padding-top: 10px; padding-bottom: 12px; border-top: 1px solid #ECE9E4; font-size: .9rem; font-weight: 500; white-space: pre-line; }
    .fwc-qr { background: #F8F7F5; padding: 16px 18px; display: flex; align-items: center; font-size: .85rem; color: #3D3A36; }
    .fwc-qr img { width: 120px; height: 120px; background: #fff; margin-right: 16px; flex-shrink: 0; }
    .fwc-full { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; background: #F4F2EF; overflow-y: auto; padding: 56px 12px 24px; }
    .fwc-full .fwc-qr img { width: 160px; height: 160px; }
    .fwc-close { position: fixed; top: 8px; right: 8px; width: 44px; height: 44px; border: 0; border-radius: 22px; background: #1A1A1A; color: #fff; font-size: 1.1rem; z-index: 101; }
</style>

@code {
    private MeDto? _me;
    private bool _loadError, _fullscreen;
    private string? _appName, _logoUrl;

    [Inject] private FeuerwehrListen.Client.Services.AppContextService AppCtx { get; set; } = default!;

    private string PhotoUrl => _me?.HasPhoto == true ? $"client-api/me/photo?v={_me.PhotoVersion}" : "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 100'><rect width='80' height='100' fill='%23E3E0DB'/><circle cx='40' cy='36' r='18' fill='%23B9B4AC'/><path d='M8 100c2-22 16-32 32-32s30 10 32 32z' fill='%23B9B4AC'/></svg>";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ctx = await AppCtx.GetAsync();
            _appName = ctx?.AppName; _logoUrl = ctx?.LogoUrl;
            _me = await Http.GetFromJsonAsync<MeDto>("client-api/me");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized) { }
        catch { _loadError = true; }
    }

    private async Task EnterFullscreen()
    {
        _fullscreen = true;
        try { await JS.InvokeVoidAsync("fwWakeLock.request"); } catch { }
    }

    private async Task ExitFullscreen()
    {
        _fullscreen = false;
        try { await JS.InvokeVoidAsync("fwWakeLock.release"); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("fwWakeLock.release"); } catch { }
    }

    private record CardDto(bool Issued, bool Valid, DateTime? ValidUntil, bool Revoked, bool HasPhoto, string? CheckUrl);
    private record MeDto(bool IsMember, string Number = "", string FirstName = "", string LastName = "", string? Rank = null, string? Unit = null, DateTime? BirthDate = null, string? IssuedBy = null,
        bool HasPhoto = false, long PhotoVersion = 0, CardDto Card = null!);
}
