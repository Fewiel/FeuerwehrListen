@page "/mein/aufgaben"
@layout MemberLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Meine Aufgaben</PageTitle>

@* Aufgaben aus dem Fuehrungskreis, die diesem Mitglied zugeordnet sind - auch ausserhalb des Kreises.
   Notizen + Status pflegen; "erledigt" landet automatisch im naechsten Protokoll. *@
<AuthGuard>
    <h1 style="font-size:1.4rem;font-weight:700;margin:4px 0 14px;">Meine Aufgaben</h1>
    @if (_tasks is null) { <p><em>Lade…</em></p> }
    else if (_tasks.Count == 0) { <div class="fwm-card text-muted">Keine Aufgaben.</div> }
    @foreach (var t in _tasks ?? new())
    {
        <section class="fwm-card" style="@(t.Status == "Erledigt" ? "opacity:.7;" : "")">
            <div style="font-weight:700;@(t.Status == "Erledigt" ? "text-decoration:line-through;" : "")">@t.Title</div>
            <div class="small text-muted mb-2">@(t.Due is DateTime d ? $"fällig {d:dd.MM.yyyy}" : "ohne Fälligkeit") · von @t.CreatedBy</div>
            @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="small mb-2" style="white-space:pre-line;">@t.Description</div> }
            <div role="group" class="d-flex mb-2" style="gap:6px;">
                @foreach (var (key, label) in new[] { ("Offen", "Offen"), ("InArbeit", "In Arbeit"), ("Erledigt", "Erledigt") })
                {
                    <button class="btn btn-sm flex-fill @(t.Status == key ? "btn-dark" : "btn-outline-secondary")" style="min-height:40px;" @onclick="() => SetStatus(t, key)">@label</button>
                }
            </div>
            <textarea class="form-control mb-2" rows="3" placeholder="Notizen…" @bind="t.Notes"></textarea>
            <div class="d-flex" style="gap:6px;">
                <button class="btn btn-outline-primary flex-fill" style="min-height:44px;" @onclick="() => SaveNotes(t)">Notiz speichern</button>
                @if (t.Status != "Erledigt") { <button class="btn btn-outline-secondary flex-fill" style="min-height:44px;" @onclick="() => ToAgenda(t)">Als Tagespunkt</button> }
            </div>
            @if (t.Msg is not null) { <div class="small text-success mt-1">@t.Msg</div> }
        </section>
    }
</AuthGuard>

@code {
    private List<TaskVm>? _tasks;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { _tasks = await Http.GetFromJsonAsync<List<TaskVm>>("client-api/me/tasks") ?? new(); } catch { _tasks = new(); }
    }

    private async Task SetStatus(TaskVm t, string status)
    {
        if (status == "Erledigt" && !await JS.InvokeAsync<bool>("confirm", "Aufgabe als erledigt melden? Sie erscheint dann im nächsten Protokoll.")) return;
        try { await Http.PutAsJsonAsync($"client-api/me/tasks/{t.Id}", new { t.Notes, Status = status }); } catch { }
        await Load();
    }

    private async Task SaveNotes(TaskVm t)
    {
        try { await Http.PutAsJsonAsync($"client-api/me/tasks/{t.Id}", new { t.Notes, Status = (string?)null }); t.Msg = "Gespeichert."; } catch { }
    }

    private async Task ToAgenda(TaskVm t)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Diese Aufgabe mit deiner Notiz als Tagespunkt für die nächste Sitzung einreichen?")) return;
        try
        {
            var r = await (await Http.PostAsJsonAsync($"client-api/me/tasks/{t.Id}/to-agenda", new { t.Notes, Status = (string?)null })).Content.ReadFromJsonAsync<AgendaResult>();
            t.Msg = r?.Scheduled == true ? "Als Tagespunkt in die nächste Sitzung aufgenommen." : "Vorgemerkt für die nächste Sitzung.";
        }
        catch { }
    }

    private class TaskVm
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public DateTime? Due { get; set; }
        public string Status { get; set; } = "Offen";
        public string Notes { get; set; } = "";
        public string CreatedBy { get; set; } = "";
        public string? Msg { get; set; }
    }
    private record AgendaResult(bool Ok, bool Scheduled);
}
