@page "/passwort-vergabe"
@layout StandaloneLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Passwort festlegen</PageTitle>

@* Vergabe-Bildschirm am Gerätehaus-Tablet. Laeuft unter der Anmeldung des Admins, der den
   Modus gestartet hat und daneben steht; der Server prueft bei jedem Schritt Admin, Whitelist-
   Geraet und aktive Sitzung. Bewusst ohne Menue. *@

<AuthGuard RequireAdmin="true">
    <div class="fwe-wrap">
        <h1 class="fwe-title">Zugang zum Mitgliederbereich</h1>
        <p class="fwe-sub">Passwort festlegen – danach von überall mit Mitgliedsnummer anmelden.</p>

        <ol class="fwe-steps" aria-label="Schritte">
            <li class="@StepClass(1)"><span>@(_step > 1 ? "✓" : "1")</span>Mitglied erkennen</li>
            <li class="@StepClass(2)"><span>@(_step > 2 ? "✓" : "2")</span>Passwort festlegen</li>
            <li class="@StepClass(3)"><span>3</span>Fertig</li>
        </ol>

        @if (_sessionLost)
        {
            <div class="alert alert-warning">
                Der Vergabe-Modus ist nicht (mehr) aktiv. <a href="/admin/passwort-vergabe">Neu starten</a>
            </div>
        }
        else if (_step == 1)
        {
            <section class="fwe-card">
                <label for="mnr" class="fwe-label">Mitgliedsnummer</label>
                <input id="mnr" class="form-control fwe-input" inputmode="numeric" autocomplete="off" @bind="_code" @bind:event="oninput"
                       @onkeyup="@(async e => { if (e.Key == "Enter") await Lookup(_code); })" />
                <button class="fwe-btn mt-3" @onclick="() => Lookup(_code)" disabled="@_busy">Weiter</button>
                <div class="fwe-or">oder Mitglieds-QR-Code scannen</div>
                <QrScanner IsActive="@(_step == 1)" OnCodeScanned="Lookup" />
                @if (_error is not null) { <div class="alert alert-danger mt-3 mb-0">@_error</div> }
            </section>
        }
        else if (_step == 2 && _member is not null)
        {
            <section class="fwe-card">
                <div class="fwe-person">
                    <img src="@PhotoUrl" alt="" />
                    <div style="flex:1;">
                        <div class="fwe-name">@_member.Name</div>
                        <div class="text-muted">Mitgliedsnummer @_member.Number@(_member.HasPassword ? " · hat bereits ein Passwort (wird ersetzt)" : "")</div>
                    </div>
                    <button class="btn btn-outline-secondary" style="min-height:44px;" @onclick="Reset">Nicht ich</button>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-sm-6">
                        <label for="p1" class="fwe-label">Neues Passwort</label>
                        <input id="p1" type="password" class="form-control fwe-input" autocomplete="new-password" @bind="_pw1" @bind:event="oninput" />
                    </div>
                    <div class="col-sm-6">
                        <label for="p2" class="fwe-label">Passwort wiederholen</label>
                        <input id="p2" type="password" class="form-control fwe-input" autocomplete="new-password" @bind="_pw2" @bind:event="oninput" />
                    </div>
                </div>
                <div class="mt-2 small">
                    <span class="@(_pw1.Length >= 10 ? "text-success" : "text-muted")">@(_pw1.Length >= 10 ? "✓" : "○") mind. 10 Zeichen</span>
                    <span class="ms-3 @(_pw1.Length > 0 && _pw1 == _pw2 ? "text-success" : "text-muted")">@(_pw1.Length > 0 && _pw1 == _pw2 ? "✓" : "○") Passwörter stimmen überein</span>
                </div>
                <button class="fwe-btn mt-3" @onclick="Save" disabled="@(_busy || _pw1.Length < 10 || _pw1 != _pw2)">Passwort festlegen</button>
                @if (_error is not null) { <div class="alert alert-danger mt-3 mb-0">@_error</div> }
            </section>
        }
        else if (_step == 3)
        {
            <section class="fwe-card text-center">
                <div style="font-size:3rem;color:#1E7A3C;"><i class="bi bi-check-circle"></i></div>
                <div class="fwe-name">Fertig!</div>
                <p class="text-muted">Anmeldung ab sofort mit Mitgliedsnummer und Passwort – auch von zuhause.</p>
                <button class="fwe-btn" @onclick="Reset">Nächstes Mitglied</button>
            </section>
        }

        <div class="fwe-foot">
            Vergabe-Modus · betreut von <strong>@_admin</strong> ·
            <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="StopMode">Modus beenden</button>
        </div>
    </div>
</AuthGuard>

<style>
    .fwe-wrap { max-width: 760px; margin: 0 auto; padding: 28px 20px 40px; }
    .fwe-title { font-size: 1.8rem; font-weight: 700; margin: 0; }
    .fwe-sub { color: #3D3A36; font-size: 1.05rem; margin: 6px 0 20px; }
    .fwe-steps { list-style: none; padding: 0; margin: 0 0 20px; display: flex; flex-wrap: wrap; }
    .fwe-steps li { display: flex; align-items: center; margin-right: 22px; margin-bottom: 6px; color: #5C5853; font-weight: 500; }
    .fwe-steps li span { width: 32px; height: 32px; border-radius: 16px; border: 2px solid #A8A29A; display: flex; align-items: center; justify-content: center; margin-right: 8px; font-weight: 700; }
    .fwe-steps li.done { color: #1E7A3C; } .fwe-steps li.done span { background: #1E7A3C; border-color: #1E7A3C; color: #fff; }
    .fwe-steps li.cur { color: #C8102E; } .fwe-steps li.cur span { background: #C8102E; border-color: #C8102E; color: #fff; }
    .fwe-card { background: #fff; border-radius: 18px; box-shadow: 0 6px 24px rgba(0,0,0,.08); padding: 24px; }
    .fwe-label { font-weight: 600; margin-bottom: 6px; display: block; }
    .fwe-input { min-height: 56px; font-size: 1.2rem; }
    .fwe-btn { width: 100%; min-height: 58px; border: 0; border-radius: 14px; background: #C8102E; color: #fff; font-weight: 600; font-size: 1.1rem; }
    .fwe-btn:disabled { opacity: .5; }
    .fwe-or { text-align: center; color: #5C5853; margin: 18px 0 10px; }
    .fwe-person { display: flex; align-items: center; padding-bottom: 18px; border-bottom: 1px solid #ECE9E4; }
    .fwe-person img { width: 80px; height: 100px; object-fit: cover; border-radius: 8px; background: #E3E0DB; margin-right: 18px; }
    .fwe-name { font-size: 1.4rem; font-weight: 700; }
    .fwe-foot { margin-top: 18px; color: #5C5853; font-size: .9rem; text-align: center; }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private int _step = 1;
    private string _code = "", _pw1 = "", _pw2 = "";
    private string? _error, _admin;
    private bool _busy, _sessionLost;
    private MemberDto? _member;

    private string PhotoUrl => _member?.HasPhoto == true
        ? $"client-api/admin/members/{_member.Id}/photo?v={_member.PhotoVersion}" : "data:image/gif;base64,R0lGODlhAQABAAAAACw=";

    private string StepClass(int s) => s < _step ? "done" : s == _step ? "cur" : "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null) _admin = (await AuthState).User.Identity?.Name;
        try
        {
            var st = await Http.GetFromJsonAsync<StatusDto>("client-api/admin/enrollment");
            _sessionLost = st?.Active != true;
        }
        catch { _sessionLost = true; }
    }

    private async Task Lookup(string code)
    {
        if (_busy || string.IsNullOrWhiteSpace(code)) return;
        _busy = true; _error = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("client-api/admin/enrollment/lookup", new { Code = code.Trim() });
            var r = await resp.Content.ReadFromJsonAsync<LookupDto>();
            if (r?.Ok == true && r.Member is not null) { _member = r.Member; _pw1 = _pw2 = ""; _step = 2; }
            else if (r?.Error == "session") _sessionLost = true;
            else _error = "Mitgliedsnummer nicht gefunden.";
        }
        catch { _error = "Prüfung fehlgeschlagen."; }
        finally { _busy = false; }
    }

    private async Task Save()
    {
        if (_member is null) return;
        _busy = true; _error = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("client-api/admin/enrollment/set", new { MemberId = _member.Id, Password = _pw1 });
            var r = await resp.Content.ReadFromJsonAsync<OkDto>();
            if (r?.Ok == true) { _step = 3; _pw1 = _pw2 = ""; }
            else if (r?.Error == "session") _sessionLost = true;
            else _error = "Passwort konnte nicht gespeichert werden.";
        }
        catch { _error = "Passwort konnte nicht gespeichert werden."; }
        finally { _busy = false; }
    }

    // Zurueck auf Anfang - keine Daten des vorigen Mitglieds bleiben stehen.
    private void Reset()
    {
        _member = null; _code = ""; _pw1 = _pw2 = ""; _error = null; _step = 1;
    }

    private async Task StopMode()
    {
        try { await Http.PostAsync("client-api/admin/enrollment/stop", null); } catch { }
        Nav.NavigateTo("/admin/passwort-vergabe");
    }

    private record StatusDto(bool Active);
    private record MemberDto(int Id, string Name, string Number, bool HasPhoto, long PhotoVersion, bool HasPassword);
    private record LookupDto(bool Ok, MemberDto? Member, string? Error = null);
    private record OkDto(bool Ok, string? Error = null);
}
